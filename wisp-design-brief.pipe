        "position": {
          "x": 560,
          "y": 300
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "out",
      "provider": "response",
      "config": {},
      "input": [
        {
          "from": "brief",
          "lane": "answers"
        }
      ],
      "ui": {
        "position": {
          "x": 940,
          "y": 300
        },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
