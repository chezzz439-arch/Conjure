# Snyk policy file.
#
# UNVERIFIED as of 2026-08-03: this was written from Snyk's documented schema,
# not generated by `snyk ignore` and not confirmed against a real scan, because
# every Snyk command — including `snyk ignore` — requires authentication and no
# SNYK_TOKEN exists yet. The first authenticated run of ./snyk_scan.sh should
# confirm that vendor/ actually drops out of the Snyk Code results. If it does
# not, regenerate this file with:
#
#   snyk ignore --file-path=vendor --reason="vendored third-party libraries"
#
# vendor/ is three.js, GLTFLoader and STLLoader — upstream code we did not write
# and cannot patch. three.min.js in particular is minified, so Snyk Code findings
# in it are unactionable noise that would bury real findings in main.py.
exclude:
  global:
    - vendor/**
